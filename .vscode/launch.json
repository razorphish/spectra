      "env": {
        "NODE_OPTIONS": "--inspect=9231"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/services/admin-ui-api/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug seq-api with Nx",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "seq-api"],
      "env": {
        "NODE_OPTIONS": "--inspect=9232"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/services/seq-api/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug quantum-api with Nx",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "quantum-api"],
      "env": {
        "NODE_OPTIONS": "--inspect=9233"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/services/quantum-api/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug corridor-api with Nx",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "corridor-api"],
      "env": {
        "NODE_OPTIONS": "--inspect=9234"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/services/corridor-api/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug ml-camp with Nx",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "ml-camp"],
      "env": {
        "NODE_OPTIONS": "--inspect=9235"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/services/ml-camp/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "Backend (Launch)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "aviate-api"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development",
        "PORT": "3001"
      }
    },
    {
      "name": "Backend (Debug)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "aviate-api"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development",
        "PORT": "3001",
        "NODE_OPTIONS": "--inspect=9230"
      }
    },
    {
      "name": "Platform (Expo)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/platform",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development",
        "EXPO_PUBLIC_API_URL": "http://localhost:3001",
        "EXPO_ROUTER_APP_ROOT": "./app",
        "NODE_PATH": "${workspaceFolder}/node_modules"
      }
    },
    {
      "name": "Platform (Expo Web)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/platform",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development",
        "EXPO_PUBLIC_API_URL": "http://localhost:3001",
        "EXPO_ROUTER_APP_ROOT": "./app",
        "NODE_PATH": "${workspaceFolder}/node_modules"
      }
    }
  ],
  "compounds": [
    {
      "name": "📱 Launch Expo Platform",
      "configurations": ["Backend (Launch)", "Platform (Expo)"],
      "presentation": { "group": "expo", "order": 1 }
    },
    {
      "name": "🐛 Debug Expo Platform",
      "configurations": ["Backend (Debug)", "Platform (Expo)"],
      "presentation": { "group": "expo", "order": 2 }
    },
    {
      "name": "🌐 Debug Expo Web Only",
      "configurations": ["Backend (Debug)", "Platform (Expo Web)"],
      "presentation": { "group": "expo", "order": 3 }
    }
  ]
}
