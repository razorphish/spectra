# Copy to `.env` and fill from Neon: Project → Branch → Connect.

# Pooled (serverless / Lambda / local `getDb()`) — often "-pooler" in host
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional: direct (non-pooler) for `npm run db:migrate` if migrate warns about websockets
# DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# Backwards-compatible alias used by @spectra/database
# NEON_DATABASE_URL=
