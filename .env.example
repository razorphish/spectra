# Copy to `.env` and adjust. Local Docker Postgres is the default for development.

# `local` → LOCAL_DATABASE_URL (or default localhost DSN) | `neon` → NEON_DATABASE_URL ?? DATABASE_URL
# Omit to use legacy resolution: DATABASE_URL ?? NEON_DATABASE_URL (CI / Lambda).
SPECTRA_DB_TARGET=local

# Optional — used when SPECTRA_DB_TARGET=local (defaults to docker-compose URL below)
# LOCAL_DATABASE_URL=postgresql://spectra:spectra@localhost:5432/spectra

# Neon pooled URL — set when SPECTRA_DB_TARGET=neon (Project → Branch → Connect in Neon console)
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional — Admin UI local dev (also supported under apps/admin-ui/.env)
# ADMIN_UI_API_BASE_URL=http://127.0.0.1:3002
# ADMIN_UI_AUTH0_ENABLED=false
# ADMIN_UI_AUTH0_DOMAIN=
# ADMIN_UI_AUTH0_CLIENT_ID=
# ADMIN_UI_AUTH0_AUDIENCE=
# Optional — full OAuth callback URL (default: {origin}/auth/callback)
# ADMIN_UI_AUTH0_REDIRECT_URI=
# Optional — post-logout returnTo (default: {origin}/auth/login; must match Auth0 Allowed Logout URLs)
# ADMIN_UI_AUTH0_LOGOUT_RETURN_TO=
#
# Auth0 Dashboard → Application Login URI (paste into Auth0; not read by build scripts):
# http://localhost:4202/auth/login
# http://127.0.0.1:4202/auth/login

# Legacy / many deployments: pooled URL (used when SPECTRA_DB_TARGET is unset, or as fallback for neon target)
# DATABASE_URL=

# Optional: direct (non-pooler) for `npm run db:migrate` if migrate warns; must match your active DB target
# DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require
