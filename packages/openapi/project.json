{
  "name": "openapi",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/openapi/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "merge": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/apps/services/aviate-api/open-api/openapi.yaml",
        "{workspaceRoot}/apps/services/seq-api/open-api/openapi.yaml",
        "{workspaceRoot}/apps/services/quantum-api/open-api/openapi.yaml",
        "{workspaceRoot}/apps/services/corridor-api/open-api/openapi.yaml",
        "{workspaceRoot}/scripts/merge-public-openapi.mjs"
      ],
      "outputs": [
        "{workspaceRoot}/packages/openapi/dist/spectra-public-api.json",
        "{workspaceRoot}/apps/services/aviate-api/src/assets/spectra-public-api.json"
      ],
      "options": {
        "command": "node scripts/merge-public-openapi.mjs"
      }
    },
    "build": {
      "dependsOn": ["merge"],
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/openapi",
        "main": "packages/openapi/src/index.ts",
        "tsConfig": "packages/openapi/tsconfig.lib.json",
        "assets": ["packages/openapi/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/openapi/jest.config.js"
      }
    }
  }
}
