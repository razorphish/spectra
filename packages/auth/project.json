{
  "name": "auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/auth/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/auth",
        "main": "packages/auth/src/index.ts",
        "tsConfig": "packages/auth/tsconfig.lib.json",
        "assets": ["packages/auth/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/auth/jest.config.js"
      }
    },
    "emit-scope-map": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/emit-scope-map-json.cjs",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
