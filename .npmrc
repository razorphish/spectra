# Spectra — npm notes:
# - Only one install at a time: package.json preinstall uses `scripts/npm-one-at-a-time.cjs` (stale lock: rm -f .npm-install.running).
# - Also avoid starting `npm install` in two terminals / Cursor agent + local shell — concurrent installs caused ENOTEMPTY on WSL.
# - Redirecting npm output to a file can fully buffer logs until exit — use `stdbuf -oL npm ... | tee log.txt` if you need live progress.
# Reduce “silent hang” during large installs; Spectra is a private app repo.
progress=true
fund=false
loglevel=notice
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
