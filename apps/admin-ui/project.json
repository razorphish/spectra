{
  "name": "admin-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/admin-ui/src",
  "tags": [],
  "targets": {
    "env-sync": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/.env",
        "{projectRoot}/.env.local",
        "{workspaceRoot}/.env",
        "{workspaceRoot}/scripts/sync-admin-ui-env.mjs"
      ],
      "outputs": ["{projectRoot}/src/environments/environment.auth0.local.ts"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node ../../scripts/sync-admin-ui-env.mjs"
      }
    },
    "build": {
      "dependsOn": ["env-sync"],
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/admin-ui",
        "browser": "apps/admin-ui/src/main.ts",
        "polyfills": ["@angular/localize/init"],
        "tsConfig": "apps/admin-ui/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/admin-ui/public"
          },
          {
            "glob": "**/*",
            "input": "apps/admin-ui/src/assets",
            "output": "/assets"
          }
        ],
        "styles": ["apps/admin-ui/src/styles.scss"],
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "sass": {
            "silenceDeprecations": [
              "color-functions",
              "global-builtin",
              "import"
            ]
          }
        },
        "allowedCommonJsDependencies": [
          "node-waves",
          "jsvectormap/dist/maps/world.js",
          "jsvectormap/dist/maps/world-merc",
          "lodash.merge",
          "jsvectormap",
          "vanta/dist/vanta.halo.min",
          "apexcharts"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "3mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "12kb"
            }
          ],
          "outputHashing": "all"
        },
        "ci-staff": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "3mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "12kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/admin-ui/src/environments/environment.ts",
              "with": "apps/admin-ui/src/environments/environment.generated.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/admin-ui/src/environments/environment.ts",
              "with": "apps/admin-ui/src/environments/environment.development.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "dependsOn": ["env-sync"],
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4202
      },
      "configurations": {
        "production": {
          "buildTarget": "admin-ui:build:production"
        },
        "development": {
          "buildTarget": "admin-ui:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "dependsOn": ["env-sync"],
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/admin-ui/jest.config.cts",
        "tsConfig": "apps/admin-ui/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "admin-ui:build",
        "port": 4202,
        "staticFilePath": "dist/apps/admin-ui/browser",
        "spa": true
      }
    }
  }
}
