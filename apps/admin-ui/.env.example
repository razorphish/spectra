# Copy to `apps/admin-ui/.env` (gitignored). Run `nx run admin-ui:env-sync` or start the dev
# server — `env-sync` runs before `serve` / `build` and regenerates
# `src/environments/environment.auth0.local.ts` from these values.

# Optional — defaults to http://127.0.0.1:3002
# ADMIN_UI_API_BASE_URL=http://127.0.0.1:3002

# Optional — topbar Swagger link. Default: aviate-api full catalog (http://127.0.0.1:3001/integration/docs/).
# When aviate-api has SPECTRA_INTEGRATION_OPENAPI_KEY set, /integration/docs requires HTTP Basic
# (SPECTRA_INTEGRATION_DOCS_BASIC_USER / PASSWORD on aviate-api); the browser will prompt once.
# Use public /docs only if you intentionally want the limited integrator view.
# ADMIN_UI_AVIATE_SWAGGER_URL=http://127.0.0.1:3001/integration/docs/

# Set true only when domain + client id are set (matches SPA guard / provideAuth0).
# ADMIN_UI_AUTH0_ENABLED=false
# ADMIN_UI_AUTH0_DOMAIN=your-tenant.us.auth0.com
# ADMIN_UI_AUTH0_CLIENT_ID=xxxxxxxx
# Custom API Identifier from Auth0 → APIs (NOT https://…auth0.com/api/v2 — that is the Management API and breaks SPA refresh / silent auth with HTTP 400).
# ADMIN_UI_AUTH0_AUDIENCE=https://spectra.admin.api
# Optional — full OAuth callback URL (default: {origin}/auth/callback; must match Auth0 Allowed Callback URLs)
# ADMIN_UI_AUTH0_REDIRECT_URI=
# Optional — post-logout returnTo URL (default: {origin}/auth/login; must match Auth0 Allowed Logout URLs)
# ADMIN_UI_AUTH0_LOGOUT_RETURN_TO=
#
# Auth0 Dashboard → Application Login URI (not read by the app; paste into Auth0):
# http://localhost:4202/auth/login
# http://127.0.0.1:4202/auth/login

# Optional overrides (same keys as above); loaded after `.env`
# Copy to `apps/admin-ui/.env.local` if you prefer not to touch `.env`.
