# Spectra platform (Expo) — local development env
# Copy to .env.development and adjust as needed.
# EXPO_PUBLIC_* values are inlined into the bundle at build time.

# Base URL for the public aviate-api service (default port 3001).
EXPO_PUBLIC_API_URL=http://localhost:3001

# expo-router source directory (relative to apps/platform).
EXPO_ROUTER_APP_ROOT=./app
