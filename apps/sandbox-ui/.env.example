# Copy to apps/sandbox-ui/.env (gitignored) or set SANDBOX_UI_* in workspace root .env

# Use localhost (not 127.0.0.1) when the browser runs on Windows and APIs run in WSL2.
SANDBOX_UI_API_BASE_URL=http://localhost:3000
# Optional: origin for public Swagger only (`/docs`). Defaults to SANDBOX_UI_API_BASE_URL.
# Use when API traffic targets a private host but docs must open on the public gateway.
# SANDBOX_UI_PUBLIC_API_DOCS_BASE_URL=http://127.0.0.1:3000
SANDBOX_UI_AUTH0_ENABLED=true
SANDBOX_UI_AUTH0_DOMAIN=dev-your-tenant.us.auth0.com
SANDBOX_UI_AUTH0_CLIENT_ID=
SANDBOX_UI_AUTH0_AUDIENCE=https://spectra.public.api
# Optional: public origin of auth-api for OAuth metadata links in the dashboard (defaults to http://127.0.0.1:9100).
# SANDBOX_UI_AUTH_API_PUBLIC_URL=http://127.0.0.1:9100
