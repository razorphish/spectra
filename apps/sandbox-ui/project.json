{
  "name": "sandbox-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sandbox",
  "sourceRoot": "apps/sandbox-ui/src",
  "tags": [],
  "implicitDependencies": ["shared-ui"],
  "targets": {
    "env-sync": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/.env",
        "{projectRoot}/.env.local",
        "{workspaceRoot}/.env",
        "{workspaceRoot}/scripts/sync-sandbox-ui-env.mjs"
      ],
      "outputs": ["{projectRoot}/src/environments/environment.auth0.local.ts"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node ../../scripts/sync-sandbox-ui-env.mjs"
      }
    },
    "build": {
      "dependsOn": ["env-sync"],
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "inputs": [
        "default",
        "{workspaceRoot}/packages/shared-ui/src/styles/**/*.css",
        "{workspaceRoot}/packages/shared-ui/src/assets/**/*",
        "{workspaceRoot}/packages/shared-ui/src/lib/**/*.ts"
      ],
      "options": {
        "outputPath": "dist/apps/sandbox-ui",
        "browser": "apps/sandbox-ui/src/main.ts",
        "tsConfig": "apps/sandbox-ui/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/sandbox-ui/public"
          },
          {
            "glob": "**/*",
            "input": "packages/shared-ui/src/assets",
            "output": "/assets/spectra"
          }
        ],
        "styles": [
          "packages/shared-ui/src/styles/spectra-tokens.css",
          "packages/shared-ui/src/styles/spectra-patterns.css",
          "apps/sandbox-ui/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/sandbox-ui/src/environments/environment.ts",
              "with": "apps/sandbox-ui/src/environments/environment.development.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "dependsOn": ["env-sync"],
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "sandbox-ui:build:production"
        },
        "development": {
          "buildTarget": "sandbox-ui:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/sandbox-ui/jest.config.js",
        "tsConfig": "apps/sandbox-ui/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "sandbox-ui:build",
        "port": 4201,
        "staticFilePath": "dist/apps/sandbox-ui/browser",
        "spa": true
      }
    }
  }
}
