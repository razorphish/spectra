{
  "name": "corridor-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/services/corridor-api",
  "projectType": "application",
  "tags": ["polyglot", "go"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/services/corridor-api",
        "command": "bash ../../../scripts/polyglot-build.sh go build -o bin/corridor-api ./cmd/corridor-api"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/services/corridor-api",
        "command": "go run ./cmd/corridor-api"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/services/corridor-api/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
