{
  "name": "seq-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/services/seq-api",
  "projectType": "application",
  "tags": ["polyglot", "dotnet"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/bin", "{projectRoot}/obj"],
      "options": {
        "cwd": "apps/services/seq-api",
        "command": "bash ../../../scripts/polyglot-build.sh dotnet build -c Release"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/services/seq-api",
        "command": "dotnet run --project SeqApi.csproj"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/services/seq-api/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
