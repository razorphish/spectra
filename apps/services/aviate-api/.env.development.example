# Public / sandbox API (aviate-api). Copy to .env.development (gitignored) or set in workspace .env.
# AUTH0_AUDIENCE must match the SPA’s Auth0 audience (e.g. sandbox-ui SANDBOX_UI_AUTH0_AUDIENCE).
AUTH0_DOMAIN=dev-your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.spectra.com
# AUTH0_ISSUER=https://dev-your-tenant.us.auth0.com/
# Local only — never in shared environments:
# AUTH0_VERIFY_DISABLED=true

# POST /v1/platform/uploads/init — presigned S3 PUT (see repo README “Uploads”).
# Use a real bucket you control; region must match the bucket.
# SPECTRA_UPLOADS_BUCKET=my-dev-uploads-bucket
# AWS_REGION=us-west-2
# Credentials: default AWS SDK chain (~/.aws/credentials, AWS_PROFILE, or env vars).
# IAM: allow s3:PutObject (and PutObject on the key prefix the API uses) for presign to work.
