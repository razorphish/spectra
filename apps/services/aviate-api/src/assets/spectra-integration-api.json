          }
        }
      }
    },
    "/v1/seq/hello": {
      "x-spectra-audience": "public",
      "get": {
        "tags": [
          "Sandbox"
        ],
        "summary": "Authenticated sandbox hello (seq segment)",
        "description": ".NET implementation of the shared hello contract. Token must include the public API audience.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Auth not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          }
        },
        "x-spectra-testing": "curl -s -H \"Authorization: Bearer $ACCESS_TOKEN\" http://127.0.0.1:3000/v1/seq/hello\n"
      }
    },
    "/v1/quantum/health": {
      "x-spectra-audience": "internal",
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/quantum/ready": {
      "x-spectra-audience": "public",
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/quantum/hello": {
      "x-spectra-audience": "public",
      "get": {
        "tags": [
          "Sandbox"
        ],
        "summary": "Authenticated sandbox hello (quantum segment)",
        "description": "Python implementation of the shared hello contract. Token must include the public API audience.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Auth not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          }
        },
        "x-spectra-testing": "curl -s -H \"Authorization: Bearer $ACCESS_TOKEN\" http://127.0.0.1:3000/v1/quantum/hello\n"
      }
    },
    "/v1/corridor/health": {
      "x-spectra-audience": "internal",
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/corridor/ready": {
      "x-spectra-audience": "public",
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/corridor/hello": {
      "x-spectra-audience": "public",
      "get": {
        "tags": [
          "Sandbox"
        ],
        "summary": "Authenticated sandbox hello (corridor segment)",
        "description": "Go implementation of the shared hello contract. Token must include the public API audience.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Auth not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          }
        },
        "x-spectra-testing": "curl -s -H \"Authorization: Bearer $ACCESS_TOKEN\" http://127.0.0.1:3000/v1/corridor/hello\n"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Auth0 access token (public/sandbox API audience)"
      }
    },
    "schemas": {
      "HelloResponse": {
        "type": "object",
        "required": [
          "message",
          "segment",
          "service",
          "authenticated",
          "principal"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "Hello from corridor-api"
          },
          "segment": {
            "type": "string",
            "example": "corridor"
          },
          "service": {
            "type": "string",
            "example": "corridor-api"
          },
          "authenticated": {
            "type": "boolean",
            "example": true
          },
          "principal": {
            "type": "object",
            "required": [
              "sub"
            ],
            "properties": {
              "sub": {
                "type": "string"
              }
            }
          }
        }
      },
      "AuthErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "InitUploadRequest": {
        "type": "object",
        "required": [
          "orgId",
          "bytesExpected"
        ],
        "properties": {
          "orgId": {
            "type": "string",
            "format": "uuid",
            "description": "Organization that owns the upload."
          },
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "Optional developer application owning the upload."
          },
          "bytesExpected": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1073741824,
            "description": "Expected byte size; capped at 1 GiB."
          },
          "contentType": {
            "type": "string",
            "description": "MIME type the client will PUT."
          },
          "filename": {
            "type": "string",
            "description": "Optional original filename (stored as metadata only)."
          }
        }
      },
      "InitUploadResponse": {
        "type": "object",
        "required": [
          "uploadId",
          "s3Bucket",
          "s3Key",
          "presignedPutUrl",
          "expiresAt"
        ],
        "properties": {
          "uploadId": {
            "type": "string",
            "format": "uuid"
          },
          "s3Bucket": {
            "type": "string"
          },
          "s3Key": {
            "type": "string"
          },
          "presignedPutUrl": {
            "type": "string",
            "format": "uri"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SandboxSessionResponse": {
        "type": "object",
        "required": [
          "userId",
          "orgId",
          "email"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "SandboxApplicationSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "updatedAt",
          "clientId",
          "hasClientSecret",
          "oauthClientType",
          "oauthGrantType"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "clientId": {
            "type": "string"
          },
          "hasClientSecret": {
            "type": "boolean"
          },
          "oauthClientType": {
            "type": "string"
          },
          "oauthGrantType": {
            "type": "string"
          }
        }
      },
      "SandboxApplicationCreateRequest": {
        "type": "object",
        "required": [
          "name",
          "redirectUris",
          "acceptSpectraTos"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "redirectUris": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptSpectraTos": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "companyWebsiteUrl": {
            "type": "string"
          },
          "privacyPolicyUrl": {
            "type": "string"
          },
          "applicationTosUrl": {
            "type": "string"
          },
          "supportEmail": {
            "type": "string"
          },
          "supportPhone": {
            "type": "string"
          },
          "developmentContacts": {
            "type": "string"
          },
          "logoUploadId": {
            "type": "string",
            "format": "uuid"
