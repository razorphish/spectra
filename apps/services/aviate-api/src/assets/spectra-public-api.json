{
  "openapi": "3.0.3",
  "info": {
    "title": "Spectra Public API",
    "version": "0.0.1",
    "description": "Unified contract for platform, seq, quantum, and corridor segments. Local dev base URL: http://127.0.0.1:3000 (local-edge)."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Local unified edge (local-edge)"
    },
    {
      "url": "https://api.example.spectra.inc",
      "description": "Deployed public gateway (placeholder)"
    }
  ],
  "paths": {
    "/v1/platform/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/platform/ready": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "OK"
          },
          "503": {
            "description": "Dependency degraded"
          }
        }
      }
    },
    "/v1/platform/info": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Service metadata",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/platform/stats": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Control-plane table row counts (MVP; authenticate in production)",
        "responses": {
          "200": {
            "description": "OK"
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      }
    },
    "/v1/platform/hello": {
      "get": {
        "tags": [
          "Sandbox"
        ],
        "summary": "Authenticated sandbox hello (platform segment)",
        "description": "Proves Auth0 bearer tokens reach aviate-api. Requires a sandbox-ui (or Swagger UI)\naccess token with the **public** API audience. Use `/health` for unauthenticated probes.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated greeting with principal `sub`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Auth0 verifier not configured on the server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          }
        },
        "x-spectra-testing": "curl -s -H \"Authorization: Bearer $ACCESS_TOKEN\" http://127.0.0.1:3000/v1/platform/hello\n"
      }
    },
    "/v1/platform/uploads/init": {
      "post": {
        "tags": [
          "Uploads"
        ],
        "summary": "Initialize an object upload (returns presigned PUT URL)",
        "description": "Creates an `uploads` row in Neon and returns a single-part PUT URL\nscoped to the env's uploads bucket. The client must `PUT` the\npayload using the same `Content-Type` (and `Content-Length` if\nprovided) used in this request. Default cap: 1 GiB.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitUploadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Upload initialized.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Uploads not configured (missing bucket env var).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/seq/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/seq/ready": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/seq/hello": {
      "get": {
        "tags": [
          "Sandbox"
        ],
        "summary": "Authenticated sandbox hello (seq segment)",
        "description": ".NET implementation of the shared hello contract. Token must include the public API audience.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Auth not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          }
        },
        "x-spectra-testing": "curl -s -H \"Authorization: Bearer $ACCESS_TOKEN\" http://127.0.0.1:3000/v1/seq/hello\n"
      }
    },
    "/v1/quantum/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/quantum/ready": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/quantum/hello": {
      "get": {
        "tags": [
          "Sandbox"
        ],
        "summary": "Authenticated sandbox hello (quantum segment)",
        "description": "Python implementation of the shared hello contract. Token must include the public API audience.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Auth not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          }
        },
        "x-spectra-testing": "curl -s -H \"Authorization: Bearer $ACCESS_TOKEN\" http://127.0.0.1:3000/v1/quantum/hello\n"
      }
    },
    "/v1/corridor/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/corridor/ready": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/corridor/hello": {
      "get": {
        "tags": [
          "Sandbox"
        ],
        "summary": "Authenticated sandbox hello (corridor segment)",
        "description": "Go implementation of the shared hello contract. Token must include the public API audience.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Auth not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          }
        },
        "x-spectra-testing": "curl -s -H \"Authorization: Bearer $ACCESS_TOKEN\" http://127.0.0.1:3000/v1/corridor/hello\n"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Auth0 access token (public/sandbox API audience)"
      }
    },
    "schemas": {
      "HelloResponse": {
        "type": "object",
        "required": [
          "message",
          "segment",
          "service",
          "authenticated",
          "principal"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "Hello from corridor-api"
          },
          "segment": {
            "type": "string",
            "example": "corridor"
          },
          "service": {
            "type": "string",
            "example": "corridor-api"
          },
          "authenticated": {
            "type": "boolean",
            "example": true
          },
          "principal": {
            "type": "object",
            "required": [
              "sub"
            ],
            "properties": {
              "sub": {
                "type": "string"
              }
            }
          }
        }
      },
      "AuthErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "InitUploadRequest": {
        "type": "object",
        "required": [
          "orgId",
          "bytesExpected"
        ],
        "properties": {
          "orgId": {
            "type": "string",
            "format": "uuid",
            "description": "Organization that owns the upload."
          },
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "Optional developer application owning the upload."
          },
          "bytesExpected": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1073741824,
            "description": "Expected byte size; capped at 1 GiB."
          },
          "contentType": {
            "type": "string",
            "description": "MIME type the client will PUT."
          },
          "filename": {
            "type": "string",
            "description": "Optional original filename (stored as metadata only)."
          }
        }
      },
      "InitUploadResponse": {
        "type": "object",
        "required": [
          "uploadId",
          "s3Bucket",
          "s3Key",
          "presignedPutUrl",
          "expiresAt"
        ],
        "properties": {
          "uploadId": {
            "type": "string",
            "format": "uuid"
          },
          "s3Bucket": {
            "type": "string"
          },
          "s3Key": {
            "type": "string"
          },
          "presignedPutUrl": {
            "type": "string",
            "format": "uri"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}