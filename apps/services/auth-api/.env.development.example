# auth-api — Spectra M2M token issuer (local). Copy to .env.development (gitignored) or set in workspace .env.
HOST=127.0.0.1
PORT=9100

# Required for minting tokens in any environment:
# M2M_MINT_ENABLED=true

# In production, set M2M_ES256_PRIVATE_JWK to a JSON EC P-256 private JWK (with kid). Omit in dev to auto-generate ephemeral keys.
# M2M_ES256_PRIVATE_JWK={"kty":"EC","crv":"P-256",...}

# SPECTRA_M2M_ISSUER=https://auth.aviate.com/
# SPECTRA_M2M_AUDIENCE=https://api.aviate.com/
# AUTH_ISSUER_OVERRIDE=http://127.0.0.1:9100/   # local only; must be unset in production

# Optional: limit mint to org ULIDs during pilot
# M2M_ORG_ALLOWLIST=...

# Same database as aviate-api for Integration / client rows
# SPECTRA_DATABASE_URL=postgresql://...
