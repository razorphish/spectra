{
  "name": "quantum-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/services/quantum-api",
  "projectType": "application",
  "tags": ["polyglot", "python"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/services/quantum-api",
        "command": "bash ../../../scripts/build-quantum-api.sh"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/services/quantum-api",
        "command": "python3 -m quantum_api.main"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/services/quantum-api/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
