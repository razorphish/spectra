PORT=3002
HOST=127.0.0.1
DATABASE_URL=postgresql://spectra:spectra@localhost:5432/spectra
# Optional: non-pooler URL for drizzle-kit migrate and admin “dedicated pg” migration runner (Settings → Runner when legacy mode is OFF).
# DATABASE_DIRECT_URL=
DATABASE_DRIVER=pg

# Auth0 access-token validation for protected routes (e.g. GET /v1/admin/stats).
# AUTH0_DOMAIN: tenant host only (no https://), e.g. your-tenant.us.auth0.com
# AUTH0_AUDIENCE: Auth0 **custom API** Identifier (JWT aud), NOT this service's host:port and NOT `…/api/v2` (Management API).
#   Must match ADMIN_UI_AUTH0_AUDIENCE in apps/admin-ui/.env — see apps/admin-ui/docs/auth0.md
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://spectra.admin.api
# Optional when token `iss` is not https://{AUTH0_DOMAIN}/
# AUTH0_ISSUER=

# Local only: decode Bearer JWT without verifying signature (never in staging/production).
# AUTH0_VERIFY_DISABLED=true

# Local only (with AUTH0_VERIFY_DISABLED): bypass Auth0 RBAC permission checks on Integrations routes.
# Never enable outside a trusted dev machine. Prefer configuring Auth0 API permissions instead:
#   platform:integrations:read, platform:integrations:export
# ADMIN_UI_API_DEV_GRANT_ALL_STAFF_PERMISSIONS=true

# Proxy authenticated OpenAPI from aviate-api (staff; requires matching key on aviate-api).
# AVIATE_API_OPENAPI_URL=http://127.0.0.1:3001/integration/openapi.json
# SPECTRA_INTEGRATION_OPENAPI_KEY=dev-integration-openapi-key

# Base URL for aviate-api, used by Settings → General → API health to probe GET /healthz.
# Defaults to http://127.0.0.1:3001 in dev when unset.
# AVIATE_API_URL=http://127.0.0.1:3001
