# Local development overrides — copy to `.env.local` (gitignored).
# Nx's env loader merges this on top of `.env`, so a Neon `.env` and a local
# `.env.local` can coexist. `.env.local` wins for the listed keys.

# Use the local Postgres container started by `docker compose up -d postgres`.
DATABASE_URL=postgresql://spectra:spectra@localhost:5432/spectra
DATABASE_DIRECT_URL=postgresql://spectra:spectra@localhost:5432/spectra

# Force the dual-driver in @spectra/database to use node-postgres locally.
# Defaults to Neon HTTP if unset; local-host URLs also auto-select 'pg'.
DATABASE_DRIVER=pg
